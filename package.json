    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/hi-melody": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.81.0",
