    "server:dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev",
    "server:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
